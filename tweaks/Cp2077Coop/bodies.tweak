// Bodies for remote players and the dev panel's mirror (TweakXL). See docs/01-architecture.md §4.
//
// The player's own third-person body, male and female, as Character records. Round O spawned these templates
// by path (Codeware DynamicEntitySpec.templatePath) and the game crashed: Codeware turns a template into a bare
// SpawnableObject record, and a PlayerPuppet built without a Character record crashes ("NPCs and vehicles may not
// function properly if spawned using template", Codeware's documentation). CyberpunkMP (Tilted Phoques SRL)
// spawns its remote players through Character records like these (its CyberpunkMP.tweak: Character.Muppet,
// based on Character.TPP_Player, with the template picked through `genders`); the body is then dressed and given
// the remote player's character customization by the plugin (src/plugin/Looks.cpp, ported from CyberpunkMP's
// AppearanceSystem).
//
// Character.TPP_Player itself spawns the female body (rounds L and M): its first `genders` entry is the female
// template. Each record here has one entry, the one it is named after.

Cp2077Coop.Character.PlayerBody_Male : Character.TPP_Player {
	entityTemplatePath = "base\characters\entities\player\player_ma_tpp.ent";
	priority = "SpawnableObjectPriority.Regular";
	reactionPreset = "ReactionPresets.NoReaction";
	genders = [
		{
			initial = true;
			gender = "Gender.Male";
			entity = "base\characters\entities\player\player_ma_tpp.ent";
		}
	];
}

Cp2077Coop.Character.PlayerBody_Female : Character.TPP_Player {
	entityTemplatePath = "base\characters\entities\player\player_wa_tpp.ent";
	priority = "SpawnableObjectPriority.Regular";
	reactionPreset = "ReactionPresets.NoReaction";
	genders = [
		{
			initial = true;
			gender = "Gender.Female";
			entity = "base\characters\entities\player\player_wa_tpp.ent";
		}
	];
}
